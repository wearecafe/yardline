APP_NAME=YardRunner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_CA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One-click /demo sign-in to the fictional Escarpment Stone yard, rebuilt
# nightly. Safe in production: the demo yard never touches Stripe.
YARDLINE_DEMO=true

# YardRunner. Drivers: flat|stripe for tax, fake|stripe for card payments.
# Use stripe for both in production.
YARDLINE_TAX_DRIVER=flat
YARDLINE_FLAT_TAX_RATE=0.13
YARDLINE_PAYMENTS_DRIVER=fake

# Contact address shown in the public help center (/help). Blank hides it.
YARDLINE_SUPPORT_EMAIL=

# Back office (/admin): staff must turn on two-factor first. Switch off
# only for local development.
YARDLINE_ADMIN_REQUIRE_2FA=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Yards' card payments run on connected accounts YardRunner creates (Stripe
# Connect). The Connect webhook endpoint has its own signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
# YardRunner's cut of each card payment, on top of Stripe's fees.
YARDLINE_APPLICATION_FEE_PERCENT=0.5
YARDLINE_APPLICATION_FEE_FIXED_CENTS=0

# Tenants' YardRunner subscriptions (Stripe Billing on the same account).
# fake subscribes on the spot with no Stripe; use stripe in production.
YARDLINE_BILLING_DRIVER=fake
YARDLINE_BILLING_AUTOMATIC_TAX=true
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION=

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Web push alerts (php artisan yardline:push:keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yardrunner.ca
